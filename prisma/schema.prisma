generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

enum Role {
  RH
  GESTOR
  FUNCIONARIO
}

enum PunchType {
  ENTRADA
  INTERVALO_ENTRADA
  INTERVALO_SAIDA
  SAIDA
}

enum DayType {
  WEEKDAY
  SATURDAY
  SUNDAY_HOLIDAY
}

// Situação da marcação: a manual feita por funcionário (ou a alteração/exclusão
// que ele pede de uma marcação sua) fica PENDING até o gestor ou o RH decidir.
enum ApprovalStatus {
  APPROVED
  PENDING
  REJECTED
}

// O que está aguardando aprovação: criar a marcação, alterar ou excluir.
enum ApprovalAction {
  CREATE
  UPDATE
  DELETE
}

// Adicional de periculosidade (30%) do dia: E = elétrico, N.E. = não elétrico.
enum HazardType {
  ELETRICO
  NAO_ELETRICO
}

// Filial em que o funcionário trabalha (lista fixa, sem regra própria).
enum Branch {
  SAVED
  JRE
  EMF
}

model User {
  id                 String    @id @default(uuid()) @db.VarChar(255)
  name               String    @db.VarChar(255)
  cpf                String    @unique @db.VarChar(255)
  phone              String    @db.VarChar(255)
  email              String    @unique @db.VarChar(255)
  password           String    @db.VarChar(255)
  department         String    @db.VarChar(255)
  birthDate          DateTime  @db.Timestamptz
  role               Role      @default(FUNCIONARIO)
  active             Boolean   @default(true)
  dailyWorkMinutes   Int       @default(480)
  workWeekdays       Int[]     @default([1, 2, 3, 4, 5])
  managerId          String?   @db.VarChar(255)
  rg                 String?   @db.VarChar(255)
  registrationNumber String?   @db.VarChar(255)
  admissionDate      DateTime? @db.Date
  branch             Branch?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  manager      User?  @relation("FK_User_Manager_ManagerId", fields: [managerId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  managedUsers User[] @relation("FK_User_Manager_ManagerId")

  timeEntries        TimeEntry[]         @relation("FK_TimeEntry_User_UserId")
  code               Code[]              @relation("FK_Code_User_UserId")
  refreshToken       RefreshToken[]      @relation("FK_RefreshToken_User_UserId")
  timeEntryAuditLogs TimeEntryAuditLog[] @relation("FK_TimeEntryAuditLog_User_ChangedByUserId")
  workDays           WorkDay[]           @relation("FK_WorkDay_User_UserId")
  paidHours          PaidHours[]         @relation("FK_PaidHours_User_UserId")
  reviewedEntries    TimeEntry[]         @relation("FK_TimeEntry_User_ReviewedById")
  notifications      Notification[]      @relation("FK_Notification_User_UserId")
  pushTokens         PushToken[]         @relation("FK_PushToken_User_UserId")
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.VarChar(255)
  userId    String   @db.VarChar(255)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation("FK_RefreshToken_User_UserId", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

model Code {
  id        String   @id @default(uuid()) @db.VarChar(255)
  userId    String   @db.VarChar(255)
  code      String   @db.VarChar(255)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  active    Boolean  @default(true)

  user User @relation("FK_Code_User_UserId", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

model TimeEntry {
  id                 String    @id @default(uuid()) @db.VarChar(255)
  userId             String    @db.VarChar(255)
  type               PunchType
  deviceTimestamp    DateTime  @db.Timestamptz
  serverReceivedAt   DateTime  @default(now()) @db.Timestamptz
  originatedOffline  Boolean   @default(false)
  latitude           Float?
  longitude          Float?
  locationCapturedAt DateTime? @db.Timestamptz
  // Endereço aproximado das coordenadas (geocodificação reversa), preenchido em
  // segundo plano depois da marcação; null enquanto não foi resolvido.
  locationAddress    String?   @db.VarChar(500)
  clientGeneratedId  String    @unique @db.VarChar(255)
  editedManually     Boolean   @default(false)
  deletedAt          DateTime? @db.Timestamptz
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // Aprovação: enquanto PENDING, uma CREATE ainda não conta nas horas; numa
  // UPDATE/DELETE continua valendo o dado atual e a mudança pedida fica em
  // pendingType/pendingDeviceTimestamp até o gestor/RH decidir.
  approvalStatus         ApprovalStatus  @default(APPROVED)
  pendingAction          ApprovalAction?
  pendingType            PunchType?
  pendingDeviceTimestamp DateTime?       @db.Timestamptz
  requestReason          String?         @db.VarChar(500)
  reviewedById           String?         @db.VarChar(255)
  reviewedAt             DateTime?       @db.Timestamptz
  reviewNote             String?         @db.VarChar(500)

  user          User                @relation("FK_TimeEntry_User_UserId", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  reviewedBy    User?               @relation("FK_TimeEntry_User_ReviewedById", fields: [reviewedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  auditLogs     TimeEntryAuditLog[] @relation("FK_TimeEntryAuditLog_TimeEntry_TimeEntryId")
  notifications Notification[]      @relation("FK_Notification_TimeEntry_TimeEntryId")

  @@index([userId, deviceTimestamp])
  @@index([approvalStatus])
}

model TimeEntryAuditLog {
  id              String   @id @default(uuid()) @db.VarChar(255)
  timeEntryId     String   @db.VarChar(255)
  changedByUserId String   @db.VarChar(255)
  action          String   @db.VarChar(20)
  previousData    Json?
  newData         Json?
  reason          String?  @db.VarChar(500)
  createdAt       DateTime @default(now())

  timeEntry     TimeEntry @relation("FK_TimeEntryAuditLog_TimeEntry_TimeEntryId", fields: [timeEntryId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  changedByUser User      @relation("FK_TimeEntryAuditLog_User_ChangedByUserId", fields: [changedByUserId], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

model OvertimePolicy {
  id         String   @id @default(uuid()) @db.VarChar(255)
  dayType    DayType  @unique
  percentage Float
  active     Boolean  @default(true)
  updatedAt  DateTime @updatedAt
}

model Holiday {
  id        String   @id @default(uuid()) @db.VarChar(255)
  date      DateTime @unique @db.Date
  name      String   @db.VarChar(255)
  createdAt DateTime @default(now())
}

// Apontamento do dia preenchido pelo RH (cliente, projeto, campo, RDO).
model WorkDay {
  id         String      @id @default(uuid()) @db.VarChar(255)
  userId     String      @db.VarChar(255)
  date       DateTime    @db.Date
  client     String?     @db.VarChar(255)
  project    String?     @db.VarChar(255)
  hazardType HazardType?
  rdoPending Boolean     @default(false)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  user User @relation("FK_WorkDay_User_UserId", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([userId, date])
}

// Horas efetivamente pagas no mês de ciclo (dia 21 do mês anterior ao dia 20 de `month`).
model PaidHours {
  id             String   @id @default(uuid()) @db.VarChar(255)
  userId         String   @db.VarChar(255)
  year           Int
  month          Int
  paid60Minutes  Int      @default(0)
  paid70Minutes  Int      @default(0)
  paid100Minutes Int      @default(0)
  locked         Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation("FK_PaidHours_User_UserId", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([userId, year, month])
}

// Aviso interno (sino no web / push no celular), ex.: marcação aguardando aprovação.
model Notification {
  id          String    @id @default(uuid()) @db.VarChar(255)
  userId      String    @db.VarChar(255)
  type        String    @db.VarChar(50)
  title       String    @db.VarChar(255)
  message     String    @db.VarChar(500)
  timeEntryId String?   @db.VarChar(255)
  readAt      DateTime? @db.Timestamptz
  createdAt   DateTime  @default(now())

  user      User       @relation("FK_Notification_User_UserId", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  timeEntry TimeEntry? @relation("FK_Notification_TimeEntry_TimeEntryId", fields: [timeEntryId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId, readAt])
}

// Token do Expo Push de cada aparelho em que o usuário está logado no app.
model PushToken {
  id        String   @id @default(uuid()) @db.VarChar(255)
  userId    String   @db.VarChar(255)
  token     String   @unique @db.VarChar(255)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation("FK_PushToken_User_UserId", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
}
